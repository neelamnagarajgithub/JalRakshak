# JalRakshak Environment Variables
# Copy this file to .env and fill in the values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jalrakshak
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_MEASUREMENTS=river.measurements.v1
KAFKA_TOPIC_ALERTS=river.alerts.v1

# Server Configuration
SERVER_PORT=9000

# Spring Profiles
SPRING_PROFILES_ACTIVE=default

# CORS: origin the React dashboard is served from. Not currently read by the
# app — CORS is wide open (any origin) in WebConfig for this prototype — kept
# here only as documentation of the dashboard's default dev-server origin.
FRONTEND_ORIGIN=http://localhost:3000

# Stream processor rule/window/suppression configuration (all optional; see
# backend/stream-processor/.../config/RuleConfig.java for the full list and
# defaults). Uncomment to override a demo default.
# RULE_LEVEL_HIGH_THRESHOLD_M=4.0
# RULE_RAIN_INTENSE_THRESHOLD_MM_H=20.0
# RULE_LEVEL_AND_RAIN_LEVEL_THRESHOLD_M=3.0
# RULE_LEVEL_AND_RAIN_RAIN_THRESHOLD_MM_H=15.0
# RULE_RISING_RATE_THRESHOLD_M=0.5
# RULE_RISING_WINDOW_MINUTES=15
# RULE_RISING_SLIDE_MINUTES=5
# RULE_SPIKE_THRESHOLD_M=1.0
# RULE_SPIKE_WARMUP_READINGS=3
# RULE_SPIKE_BASELINE_WINDOW_MINUTES=60
# RULE_STALE_TIMEOUT_MINUTES=30
# WATERMARK_OUT_OF_ORDERNESS_MINUTES=5
# ALERT_SUPPRESSION_WINDOW_MINUTES=60
# KAFKA_CONSUMER_GROUP=jalrakshak-stream-processor

# Frontend (read by Vite at build/dev time, must be prefixed VITE_)
VITE_API_BASE_URL=http://localhost:9000/api/v1