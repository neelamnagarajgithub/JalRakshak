# JalRakshak Environment Variables
# Copy this file to .env and fill in the values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jalrakshak
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_MEASUREMENTS=river.measurements.v1
KAFKA_TOPIC_ALERTS=river.alerts.v1

# Server Configuration
SERVER_PORT=9000

# Spring Profiles
SPRING_PROFILES_ACTIVE=default